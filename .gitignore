roms/
soundfonts/
work/
out/
songs/import/FILES/
songs/private/
songs/src/
songs/src-private/

# build products
web/dist/
web/node_modules/
node_modules/
admin/web/dist/
__pycache__/
*.pyc
.pytest_cache/
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl.bak
