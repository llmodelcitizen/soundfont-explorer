# local-only data on the workstation's /home volume (never in git)
roms/
soundfonts/
work/
out/
songs/import/FILES/
# songs/private/ and songs/src/ were the two pre-Library ways a MIDI became a song and are
# gone from the tooling; still ignored so a leftover local copy can never be committed.
songs/private/
songs/src/
songs/src-private/

# build products
web/dist/
web/node_modules/
node_modules/
admin/web/dist/
__pycache__/
*.pyc
.pytest_cache/
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl.bak
crash.log

# legacy MVP leftovers
vendor/libADLMIDI/
vendor/*.log

# editors / OS
.DS_Store
*.swp
.vscode/
.idea/

# terraform local artefacts
infra/**/.terraform/
infra/**/terraform.tfstate*
infra/modules/*/lambda/*.zip

# deployment identity: symlinks into the private overlay (scripts/overlay.sh); *.example are tracked
infra/live/backend.hcl
infra/live/terraform.tfvars
infra/live/outputs.json
web/.env.local

# the corpus: every song is a library file (songs/import/FILES/, ignored above), so
# everything canon.py derives from it is build output — the canonical MIDIs, the fragment,
# songs.json, the refusal report. The repository ships the tools and the licence notices,
# not the music; a box or a workstation restores these from s3://<admin-bucket>/canon/.
songs/rendered/
songs/corpus-imports.json
songs/songs.json
songs/canon-report.json

# agent worktrees (created by Claude Code workflows; never part of the repo)
.claude/worktrees/
