# terraform local artefacts
infra/**/.terraform/
infra/**/terraform.tfstate*
infra/modules/*/lambda/*.zip

# deployment identity: symlinks into the private overlay (scripts/overlay.sh); *.example are tracked
infra/live/backend.hcl
infra/live/terraform.tfvars
infra/live/outputs.json
web/.env.local

# imported music: sources are gitignored (songs/import/FILES/), so their canonical
# copies are too — only the freely licensed corpus is committed
# canonical MIDIs for imports mirror the import tree (subdirs) or land at the rendered/
# root (imports with no directory). The 13 curated rendered/*.mid are tracked already —
# gitignore never hides tracked files — but a NEW curated song needs `git add -f`.
songs/rendered/*/
songs/rendered/*.mid
songs/corpus-imports.json
songs/canon-report.json
