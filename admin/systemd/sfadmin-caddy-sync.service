# Persist Caddy's Let's Encrypt material to the admin bucket so a relaunched box reuses
# its certificate instead of burning LE rate limits. Installed by bootstrap.sh.
[Unit]
Description=sync /var/lib/caddy to the admin bucket

[Service]
Type=oneshot
EnvironmentFile=/etc/sfadmin.env
ExecStart=/usr/bin/aws s3 sync /var/lib/caddy s3://${SFADMIN_BUCKET}/caddy/ --size-only
