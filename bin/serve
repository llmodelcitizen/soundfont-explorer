#!/usr/bin/env python3
"""serve - web server for the MIDI player browser (LAN-reachable).

Python's stock http.server does not implement HTTP Range requests, which
audio elements need in order to seek without downloading whole 64 MB WAVs.
This adds proper 206 Partial Content support. It listens on all interfaces
by default so other machines on your LAN can use the player; pass
--bind 127.0.0.1 to keep it to this box. It serves the whole repo directory,
read-only, with no authentication -- it is meant for a trusted home network.

    bin/serve [PORT] [--bind ADDR] [--no-browser]
"""
import os, sys, re, json, socket, argparse, mimetypes, webbrowser
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))   # repo root (bin/..)
CHUNK = 2 * 1024 * 1024      # max bytes per 206 response

mimetypes.add_type('audio/wav', '.wav')

RANGE_RE = re.compile(r'bytes=(\d*)-(\d*)$')


class Handler(SimpleHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def __init__(self, *a, **kw):
        super().__init__(*a, directory=ROOT, **kw)

    def log_message(self, fmt, *args):
        first = str(args[0]) if args else ''
        if '/out/' not in first:                          # don't spam per audio chunk
            try:
                sys.stderr.write("  %s\n" % (fmt % args))
            except Exception:
                sys.stderr.write("  %s %r\n" % (fmt, args))

    def do_GET(self):
        if self.path.split('?', 1)[0] == '/api/songs':
            return self.send_songs()
        return super().do_GET()

    def send_songs(self):
        """JSON list of rendered songs: every out/<song>/ that has a manifest.json."""
        outdir = os.path.join(ROOT, 'out')
        songs = sorted(d for d in (os.listdir(outdir) if os.path.isdir(outdir) else [])
                       if os.path.isfile(os.path.join(outdir, d, 'manifest.json')))
        body = json.dumps(songs).encode()
        self._range = None
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_head(self):
        rng = self.headers.get('Range')
        if not rng:
            self._range = None
            return super().send_head()

        m = RANGE_RE.match(rng.strip())
        if not m:
            self.send_error(400, 'Malformed Range header')
            return None

        path = self.translate_path(self.path)
        try:
            f = open(path, 'rb')
        except OSError:
            self.send_error(404, 'Not found')
            return None

        size = os.fstat(f.fileno()).st_size
        first_s, last_s = m.group(1), m.group(2)

        if first_s == '':                       # suffix range: bytes=-N (last N bytes)
            if last_s == '':
                f.close(); self.send_error(400, 'Malformed Range header'); return None
            length = min(int(last_s), size)
            first, last = size - length, size - 1
        else:
            first = int(first_s)
            last = int(last_s) if last_s else size - 1
            last = min(last, size - 1)

        # A server may legally return less than the requested range. Capping the
        # body keeps each response short-lived, so connections are released back
        # to the browser's 6-per-origin pool instead of being held by one stream.
        if last - first + 1 > CHUNK:
            last = first + CHUNK - 1

        if first >= size or first > last:
            f.close()
            self.send_response(416)
            self.send_header('Content-Range', 'bytes */%d' % size)
            self.send_header('Content-Length', '0')
            self.end_headers()
            return None

        self._range = (first, last)
        f.seek(first)
        self.send_response(206)
        self.send_header('Content-Type', self.guess_type(path))
        self.send_header('Accept-Ranges', 'bytes')
        self.send_header('Content-Range', 'bytes %d-%d/%d' % (first, last, size))
        self.send_header('Content-Length', str(last - first + 1))
        self.end_headers()
        return f

    def copyfile(self, source, outputfile):
        if getattr(self, '_range', None) is None:
            return super().copyfile(source, outputfile)
        first, last = self._range
        remaining = last - first + 1
        while remaining > 0:
            chunk = source.read(min(64 * 1024, remaining))
            if not chunk:
                break
            try:
                outputfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError):
                return                                    # browser seeked away
            remaining -= len(chunk)

    def end_headers(self):
        if getattr(self, '_range', None) is None:
            self.send_header('Accept-Ranges', 'bytes')
        # renders are immutable; letting the browser cache them is what stops
        # it re-fetching 64 MB every time a neighbour is resynced. The manifest
        # beside them is NOT: fmdump rewrites it on every render.
        if self.path.startswith('/out/') and self.path.lower().endswith('.wav'):
            self.send_header('Cache-Control', 'public, max-age=31536000, immutable')
        else:
            self.send_header('Cache-Control', 'no-cache')
        super().end_headers()

    def setup(self):
        super().setup()
        # never let a thread block forever writing to a socket nobody drains
        self.connection.settimeout(60)


def lan_ip():
    """The address other LAN machines reach us at. Opens a UDP socket towards a
    public address to learn which interface would route there; nothing is sent."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(('192.0.2.1', 9))           # TEST-NET-1, never actually contacted
            return s.getsockname()[0]
    except OSError:
        return None


if __name__ == '__main__':
    ap = argparse.ArgumentParser(description='Soundfont Explorer web player server')
    ap.add_argument('port', nargs='?', type=int, default=8731)
    ap.add_argument('--bind', default='0.0.0.0', metavar='ADDR',
                    help='address to listen on (default: all interfaces; 127.0.0.1 = this box only)')
    ap.add_argument('--no-browser', action='store_true', help="don't open a browser tab")
    a = ap.parse_args()

    srv = ThreadingHTTPServer((a.bind, a.port), Handler)
    srv.daemon_threads = True
    local_url = 'http://127.0.0.1:%d/web/' % a.port
    print('Soundfont Explorer player  ->  %s' % local_url, flush=True)
    if a.bind == '0.0.0.0':
        ip = lan_ip()
        if ip:
            print('from your LAN     ->  http://%s:%d/web/' % (ip, a.port), flush=True)
        print('serving %s on all interfaces   Ctrl+C to stop' % ROOT, flush=True)
    else:
        print('serving %s on %s   Ctrl+C to stop' % (ROOT, a.bind), flush=True)
    try:
        if not a.no_browser:
            webbrowser.open(local_url)
    except Exception:
        pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print('\nstopped')
