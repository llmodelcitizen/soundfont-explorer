#!/usr/bin/env bash
# fmdump - render a MIDI file through many OPL3 FM banks in parallel.
#
# Wraps adlmidiplay (libADLMIDI, Nuked OPL3 core) to dump one WAV per FM bank,
# so you can A/B the 79 banks and find the SB Pro / SB16 tone you remember.

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
BANKS_FILE="$ROOT/data/banks.txt"
OUTROOT="${FMDUMP_OUT:-$ROOT/out}"
# Prefer the libADLMIDI build vendored in this repo; fall back to whatever is on PATH.
[[ -d "$ROOT/vendor/libADLMIDI/build" ]] && PATH="$ROOT/vendor/libADLMIDI/build:$PATH"

JOBS="$(nproc 2>/dev/null || echo 8)"
BANKSPEC="all"
EMU="nuked"
VM=5            # 5 = "9x SB16" volume model
CHIPS=1         # 1 chip = authentic hardware polyphony
GAIN=2.0
FOUROP=""
TRIM=""
KEEP=0

# ---- worker mode: render exactly one bank (invoked by xargs) ---------------
if [[ "${1:-}" == "--render-one" ]]; then
  bank="$2"; slug="$3"
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  ln -s "$FMD_MIDI" "$work/$slug.mid"
  args=( "$work/$slug.mid" -w -nl "--emu-$FMD_EMU" -vm "$FMD_VM" --gain "$FMD_GAIN" )
  ( cd "$work" && timeout 900 adlmidiplay "${args[@]}" "$bank" "$FMD_CHIPS" $FMD_4OP \
      >/dev/null 2>"$work/err.log" )
  rc=$?
  if [[ $rc -ne 0 || ! -s "$work/$slug.mid.wav" ]]; then
    echo "FAIL bank $bank ($slug) rc=$rc: $(tail -1 "$work/err.log" 2>/dev/null)" >&2
    exit 1
  fi
  mv "$work/$slug.mid.wav" "$FMD_OUT/$slug.wav"
  if [[ -n "$FMD_TRIM" ]]; then
    python3 - "$FMD_OUT/$slug.wav" "$FMD_TRIM" <<'PY'
import sys, wave
path, secs = sys.argv[1], float(sys.argv[2])
with wave.open(path) as w:
    p = w.getparams(); n = min(w.getnframes(), int(secs * w.getframerate()))
    frames = w.readframes(n)
with wave.open(path, 'wb') as o:
    o.setparams(p); o.setnframes(n); o.writeframes(frames)
PY
  fi
  printf '%s\n' "$slug"
  exit 0
fi

usage() {
  cat <<'USAGE'
fmdump - dump one WAV per OPL3 FM bank, in parallel

Usage: fmdump [options] MIDIFILE...

Options:
  -j N        Parallel render jobs (default: number of CPUs)
  -b SPEC     Banks: "all" (default, 0-78), a list "15,16,72",
              a range "0-20", or a preset:
                sb      Sound Blaster / AdLib driver banks
                doom    DMX banks (Doom, Heretic, Hexen, Strife)
                apogee  Apogee Sound System (Duke3D, ROTT)
                win     Windows 3.x / 9x driver banks
  -e EMU      OPL emulator core: nuked (default, cycle-accurate), nuked7,
              nuked-cqm, dosbox, opal, java, esfmu, ymfm-opl3; OPL2 cores:
              nuked-opl2, dosbox-opl2, mame-opl2, ymfm-opl2
  -m N        Volume model, 0-14 (default 5 = "9x SB16")
  -c N        Emulated OPL3 chips (default 1 = authentic polyphony limit)
  -g F        Gain (default 2.0)
  -4 N        Number of 4-operator channels
  -t SECS     Trim each WAV to SECS seconds (fast auditioning)
  -o DIR      Output root (default: out/ in this repo)
  -k          Keep going if some banks fail
  -h          Help

Input may be .mid/.midi, .mus (Doom) or .xmi (Miles) - converted automatically.

Examples:
  fmdump midi/STARWARS.MID                 # all 79 banks, one job per CPU (~5 GB)
  fmdump -b sb -t 30 midi/STARWARS.MID     # just SB banks, 30s previews
  fmdump -b doom -e dosbox song.mus        # Doom MUS via DOSBox OPL core
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -j) JOBS="$2"; shift 2 ;;
    -b) BANKSPEC="$2"; shift 2 ;;
    -e) EMU="$2"; shift 2 ;;
    -m) VM="$2"; shift 2 ;;
    -c) CHIPS="$2"; shift 2 ;;
    -g) GAIN="$2"; shift 2 ;;
    -4) FOUROP="$2"; shift 2 ;;
    -t) TRIM="$2"; shift 2 ;;
    -o) OUTROOT="$2"; shift 2 ;;
    -k) KEEP=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "fmdump: unknown option '$1'" >&2; exit 2 ;;
    *)  break ;;
  esac
done

[[ $# -eq 0 ]] && { usage >&2; exit 2; }
command -v adlmidiplay >/dev/null || { echo "fmdump: adlmidiplay not found (build vendor/libADLMIDI, see README)" >&2; exit 1; }
[[ -r "$BANKS_FILE" ]] || { echo "fmdump: missing bank list $BANKS_FILE" >&2; exit 1; }
# adlmidiplay treats an unknown --emu-X as a bank *file*; every render would fail. Check first.
if ! adlmidiplay 2>&1 | grep -q -- "--emu-$EMU "; then
  echo "fmdump: unknown OPL core '$EMU'. Available: $(adlmidiplay 2>&1 | grep -oE -- '--emu-[a-z0-9-]+' | sed 's/--emu-//' | tr '\n' ' ')" >&2
  exit 2
fi

# ---- resolve which banks to render ----------------------------------------
select_banks() {
  case "$1" in
    all)    cut -d' ' -f1 "$BANKS_FILE" ;;
    sb)     grep -E '^[0-9]+ = (SB|WOPL \(The Fat Man|WOPL \(MS-AdLib)' "$BANKS_FILE" | cut -d' ' -f1 ;;
    doom)   grep -iE '= DMX' "$BANKS_FILE" | cut -d' ' -f1 ;;
    apogee) grep -iE 'Apogee' "$BANKS_FILE" | cut -d' ' -f1 ;;
    win)    grep -iE 'Win9x|Windows 3|MS-AdLib|9x' "$BANKS_FILE" | cut -d' ' -f1 ;;
    *-*)    seq "${1%-*}" "${1#*-}" ;;
    *)      tr ',' '\n' <<< "$1" ;;
  esac
}

slug_for() {  # bank number -> "NN_Sanitised_Name"
  local n="$1" name
  name=$(awk -F' = ' -v b="$n" '$1==b{print $2}' "$BANKS_FILE")
  [[ -z "$name" ]] && name="bank$n"
  name=$(tr -cs 'A-Za-z0-9' '_' <<< "$name" | sed 's/^_//; s/_$//')
  printf '%02d_%s' "$n" "$name"
}

for MIDI in "$@"; do
  [[ -r "$MIDI" ]] || { echo "fmdump: cannot read '$MIDI'" >&2; continue; }
  SRC="$(readlink -f "$MIDI")"
  BASE="$(basename "${MIDI%.*}")"

  # Doom MUS / Miles XMI -> standard MIDI
  case "${MIDI,,}" in
    *.mus) conv="$(mktemp --suffix=.mid)"; mus2mid "$SRC" "$conv" >/dev/null 2>&1 \
             && { echo "converted MUS -> MIDI"; SRC="$conv"; } ;;
    *.xmi) conv="$(mktemp --suffix=.mid)"; xmi2mid "$SRC" "$conv" >/dev/null 2>&1 \
             && { echo "converted XMI -> MIDI"; SRC="$conv"; } ;;
  esac

  OUT="$OUTROOT/$BASE"
  mkdir -p "$OUT"

  mapfile -t BANKLIST < <(select_banks "$BANKSPEC" | grep -E '^[0-9]+$' | sort -n -u)
  [[ ${#BANKLIST[@]} -eq 0 ]] && { echo "fmdump: no banks matched '$BANKSPEC'" >&2; exit 1; }

  echo "fmdump: $BASE -> $OUT"
  echo "  banks=${#BANKLIST[@]}  jobs=$JOBS  emu=$EMU  volume-model=$VM  chips=$CHIPS${TRIM:+  trim=${TRIM}s}"

  : > "$OUT/index.tsv"
  jobfile="$(mktemp)"
  for b in "${BANKLIST[@]}"; do
    s="$(slug_for "$b")"
    printf '%s\t%s\n' "$b" "$s" >> "$jobfile"
    printf '%s\t%s\t%s.wav\n' "$b" "$(awk -F' = ' -v n="$b" '$1==n{print $2}' "$BANKS_FILE")" "$s" >> "$OUT/index.tsv"
  done

  export FMD_MIDI="$SRC" FMD_OUT="$OUT" FMD_EMU="$EMU" FMD_VM="$VM" \
         FMD_CHIPS="$CHIPS" FMD_GAIN="$GAIN" FMD_TRIM="$TRIM" FMD_4OP="$FOUROP"

  START=$SECONDS
  ok=$(awk -F'\t' '{print $1"\n"$2}' "$jobfile" \
       | xargs -P "$JOBS" -n 2 "$SELF" --render-one 2>"$OUT/errors.log" | wc -l)
  ELAPSED=$((SECONDS-START))
  rm -f "$jobfile"

  fails=$(( ${#BANKLIST[@]} - ok ))
  echo "  rendered $ok/${#BANKLIST[@]} in ${ELAPSED}s -> $(du -sh "$OUT" | cut -f1)"
  if [[ $fails -gt 0 ]]; then
    echo "  $fails failed (see $OUT/errors.log)" >&2
    [[ $KEEP -eq 0 ]] && head -5 "$OUT/errors.log" >&2
  fi

  # playlist, ordered by bank number
  ( cd "$OUT" && ls *.wav 2>/dev/null | sort > playlist.m3u )

  # manifest.json for the web player: bank/name/file from index.tsv plus the
  # WAV header facts the page needs (duration, size, rate) for each render.
  python3 - "$OUT" "$(basename "$MIDI")" <<'PY'
import json, os, sys, wave
out, source = sys.argv[1], sys.argv[2]
tracks = []
with open(os.path.join(out, 'index.tsv')) as f:
    for line in f:
        bank, name, file = line.rstrip('\n').split('\t')
        path = os.path.join(out, file)
        if not os.path.isfile(path):
            continue                        # failed render; leave it out
        try:
            with wave.open(path) as w:
                rate, ch, bits, n = w.getframerate(), w.getnchannels(), 8 * w.getsampwidth(), w.getnframes()
        except wave.Error as e:
            print('manifest: skipping %s: %s' % (file, e), file=sys.stderr)
            continue
        tracks.append({'bank': int(bank), 'name': name, 'file': file,
                       'dur': round(n / rate, 3), 'bytes': os.path.getsize(path),
                       'rate': rate, 'ch': ch, 'bits': bits})
with open(os.path.join(out, 'manifest.json'), 'w') as f:
    json.dump({'source': source, 'tracks': tracks}, f, indent=1)
print('  manifest.json: %d tracks' % len(tracks))
PY
done
