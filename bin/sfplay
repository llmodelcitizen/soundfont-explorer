#!/usr/bin/env bash
# sfplay - a basic General MIDI player using SoundFonts (FluidSynth front-end).
# Plays .mid/.midi files, the kind that were everywhere in the 90s.

set -uo pipefail

SF_DEFAULT="/usr/share/sounds/sf2/FluidR3_GM.sf2"
SOUNDFONT="${SFPLAY_SOUNDFONT:-$SF_DEFAULT}"
GAIN="${SFPLAY_GAIN:-0.6}"
RATE=48000          # matches PipeWire's native rate; avoids a resample step
OUTFILE=""
LOOP=0
SHUFFLE=0
QUIET=0
FILES=()

usage() {
  cat <<'USAGE'
sfplay - basic General MIDI player

Usage: sfplay [options] FILE|DIR...

Options:
  -s, --soundfont PATH  SoundFont to use (.sf2/.sf3)
  -g, --gain N          Volume, 0.0-10.0 (default 0.6)
  -o, --output FILE     Render to a .wav file instead of playing
  -l, --loop            Repeat the playlist forever
  -r, --random          Shuffle the playlist
  -q, --quiet           Don't print track names
  -h, --help            This help

Directories are scanned (recursively) for .mid/.midi files.

Examples:
  sfplay STARWARS.MID
  sfplay -r -l midi/                   # shuffled endless playlist
  sfplay -o theme.wav STARWARS.MID     # render to audio file
  sfplay -s /path/to/other.sf2 x.mid   # different instrument set

Env: SFPLAY_SOUNDFONT, SFPLAY_GAIN
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--soundfont) SOUNDFONT="$2"; shift 2 ;;
    -g|--gain)      GAIN="$2"; shift 2 ;;
    -o|--output)    OUTFILE="$2"; shift 2 ;;
    -l|--loop)      LOOP=1; shift ;;
    -r|--random)    SHUFFLE=1; shift ;;
    -q|--quiet)     QUIET=1; shift ;;
    -h|--help)      usage; exit 0 ;;
    --)             shift; FILES+=("$@"); break ;;
    -*)             echo "sfplay: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    *)              FILES+=("$1"); shift ;;
  esac
done

[[ ${#FILES[@]} -eq 0 ]] && { usage >&2; exit 2; }

if [[ ! -r "$SOUNDFONT" ]]; then
  echo "sfplay: soundfont not readable: $SOUNDFONT" >&2
  echo "  install one with:  sudo apt install fluid-soundfont-gm" >&2
  exit 1
fi

# Expand directories into the .mid/.midi files they contain.
PLAYLIST=()
for f in "${FILES[@]}"; do
  if [[ -d "$f" ]]; then
    while IFS= read -r -d '' m; do PLAYLIST+=("$m"); done \
      < <(find "$f" -type f \( -iname '*.mid' -o -iname '*.midi' -o -iname '*.rmi' \) -print0 | sort -z)
  elif [[ -r "$f" ]]; then
    PLAYLIST+=("$f")
  else
    echo "sfplay: cannot read '$f'" >&2
  fi
done

[[ ${#PLAYLIST[@]} -eq 0 ]] && { echo "sfplay: no MIDI files found" >&2; exit 1; }

if [[ $SHUFFLE -eq 1 ]]; then
  mapfile -t PLAYLIST < <(printf '%s\n' "${PLAYLIST[@]}" | shuf)
fi

# libinstpatch spews harmless GObject warnings on every start; drop them.
denoise() { grep -vE 'GLib-GObject|g_param_spec|validate_pspec|^\(process:[0-9]+\)|^$'; }

# Render mode: one output file, so mix the whole playlist in sequence is not
# supported by fluidsynth -- render the first file only if several were given.
if [[ -n "$OUTFILE" ]]; then
  if [[ ${#PLAYLIST[@]} -gt 1 ]]; then
    echo "sfplay: --output renders one file; using '${PLAYLIST[0]}'" >&2
  fi
  [[ $QUIET -eq 0 ]] && echo "Rendering: ${PLAYLIST[0]} -> $OUTFILE"
  fluidsynth -F "$OUTFILE" -g "$GAIN" -q "$SOUNDFONT" "${PLAYLIST[0]}" 2>&1 | denoise
  exit "${PIPESTATUS[0]}"
fi

trap 'echo; exit 130' INT

while :; do
  for m in "${PLAYLIST[@]}"; do
    [[ $QUIET -eq 0 ]] && echo "♪ $(basename "$m")"
    fluidsynth -a pulseaudio -r "$RATE" -g "$GAIN" -niq "$SOUNDFONT" "$m" 2>&1 | denoise
  done
  [[ $LOOP -eq 1 ]] || break
done
