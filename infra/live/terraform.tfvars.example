# Copy to terraform.tfvars in your private overlay (scripts/overlay.sh links it here).
domain      = "soundfonts.example.com"   # served by CloudFront; ACM cert is DNS-validated in zone_name
zone_name   = "example.com."             # existing Route 53 hosted zone, trailing dot
alert_email = "you@example.com"          # budget, circuit-breaker and SNS notifications

# Module gates. Persist them HERE once enabled — never pass them as one-off `-var`
# flags. An apply that omits a -var sees the default (false) and plans to DESTROY that
# module's resources (Batch CE, ECR repo with its images, watchdog, budgets, ...).
# enable_render_fleet = true
# enable_admin        = true
