#!/usr/bin/env bash
# fmplay - play a MIDI/MUS/XMI file through emulated OPL3 FM synthesis.
# Default bank 58 = The Fat Man 2op set as shipped in the Windows 9x
# Sound Blaster 16 driver, with the "9x SB16" volume model.

set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BANKS="$ROOT/data/banks.txt"
# Prefer the libADLMIDI build vendored in this repo; fall back to whatever is on PATH.
[[ -d "$ROOT/vendor/libADLMIDI/build" ]] && PATH="$ROOT/vendor/libADLMIDI/build:$PATH"
BANK=58; EMU=nuked; VM=5; CHIPS=1; GAIN=2.0

usage() {
  cat <<'USAGE'
fmplay - OPL3 FM synthesis MIDI player (Sound Blaster / AdLib sound)

Usage: fmplay [options] FILE.mid|FILE.mus|FILE.xmi

  -b N     FM bank 0-78 (default 58 = Win9x SB16 "Fat Man" 2op set)
  -e EMU   OPL core: nuked (default), nuked7, nuked-cqm, dosbox, opal, java,
           esfmu, ymfm-opl3; OPL2 cores (AdLib / SB Pro mono FM): nuked-opl2,
           dosbox-opl2, mame-opl2, ymfm-opl2
  -m N     Volume model 0-14 (default 5 = "9x SB16")
  -c N     Emulated chips (default 1 = authentic OPL3 polyphony)
  -g F     Gain (default 2.0)
  -l       List all 79 banks and exit
  -h       Help

Notable banks:
   0  AIL "The Fat Man" 2op  - the default AIL/Miles DOS sound
  15  DMX (Cygnus Studios)   - Doom / Heretic / Hexen
  16  DMX (Bobby Prince v1)  - Doom's original
  58  Fat Man 2op, Win9x     - Windows SB16 General MIDI  <- the classic
  67  Apogee Sound System    - Duke Nukem 3D / Rise of the Triad
  77  MS-AdLib, Windows 3.x
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b) BANK="$2"; shift 2 ;;
    -e) EMU="$2"; shift 2 ;;
    -m) VM="$2"; shift 2 ;;
    -c) CHIPS="$2"; shift 2 ;;
    -g) GAIN="$2"; shift 2 ;;
    -l) [[ -r "$BANKS" ]] && cat "$BANKS" || adlmidiplay 2>&1 | grep -E '[0-9]+ = '; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "fmplay: unknown option '$1'" >&2; exit 2 ;;
    *)  break ;;
  esac
done
[[ $# -eq 0 ]] && { usage >&2; exit 2; }
command -v adlmidiplay >/dev/null || { echo "fmplay: adlmidiplay not found (build vendor/libADLMIDI, see README)" >&2; exit 1; }
# adlmidiplay treats an unknown --emu-X as a bank *file* and fails confusingly; check first.
if ! adlmidiplay 2>&1 | grep -q -- "--emu-$EMU "; then
  echo "fmplay: unknown OPL core '$EMU'. Available: $(adlmidiplay 2>&1 | grep -oE -- '--emu-[a-z0-9-]+' | sed 's/--emu-//' | tr '\n' ' ')" >&2
  exit 2
fi

SRC="$1"
[[ -r "$SRC" ]] || { echo "fmplay: cannot read '$SRC'" >&2; exit 1; }
case "${SRC,,}" in
  *.mus) t=$(mktemp --suffix=.mid); mus2mid "$SRC" "$t" >/dev/null 2>&1 && SRC="$t" ;;
  *.xmi) t=$(mktemp --suffix=.mid); xmi2mid "$SRC" "$t" >/dev/null 2>&1 && SRC="$t" ;;
esac

name=$(awk -F' = ' -v b="$BANK" '$1==b{print $2}' "$BANKS" 2>/dev/null)
echo "♪ $(basename "$1")  [bank $BANK${name:+ - $name}, $EMU core]"
exec adlmidiplay "$SRC" -nl "--emu-$EMU" -vm "$VM" --gain "$GAIN" "$BANK" "$CHIPS"
